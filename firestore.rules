rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write their own document,
    // but cannot modify protected subscription/billing fields.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && !('subscriptionStatus' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripePriceId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('plan' in request.resource.data);

      // Only Cloud Functions / Admin SDK can touch billing fields
      allow write: if false; // default deny — admin writes bypass rules
    }

    // All other collections: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
